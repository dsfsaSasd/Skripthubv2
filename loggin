-- ==================== POLONIU LABEL SYSTEM ====================
local TAG_NAME = "PoloniuUser"
local labelBillboards = {}
local labelConnections = {}

local function applyLabel(player)
    if player == localPlayer then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    if not char:FindFirstChild(TAG_NAME) then return end

    if labelBillboards[player.UserId] then
        labelBillboards[player.UserId]:Destroy()
    end

    local bb = Instance.new("BillboardGui")
    bb.Name = "PoloniuBillboard"
    bb.Size = UDim2.new(0, 140, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0, 200, 255)
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    lbl.TextStrokeTransparency = 0
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = "Poloniu"
    lbl.Parent = bb

    labelBillboards[player.UserId] = bb
end

local function watchPlayer(player)
    if player == localPlayer then return end

    local conn = player.CharacterAdded:Connect(function()
        task.wait(1)
        applyLabel(player)
    end)
    labelConnections[player.UserId] = conn

    applyLabel(player)
end

local function removePlayer(player)
    if labelBillboards[player.UserId] then
        labelBillboards[player.UserId]:Destroy()
        labelBillboards[player.UserId] = nil
    end
    if labelConnections[player.UserId] then
        labelConnections[player.UserId]:Disconnect()
        labelConnections[player.UserId] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(removePlayer)

RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end
        local char = player.Character
        if char then
            local hasTag = char:FindFirstChild(TAG_NAME) ~= nil
            local hasLabel = labelBillboards[player.UserId] ~= nil
            if hasTag and not hasLabel then
                applyLabel(player)
            elseif not hasTag and hasLabel then
                labelBillboards[player.UserId]:Destroy()
                labelBillboards[player.UserId] = nil
            end
        end
    end
end)

local function tagSelf()
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    if not char:FindFirstChild(TAG_NAME) then
        local tag = Instance.new("StringValue")
        tag.Name = TAG_NAME
        tag.Value = localPlayer.Name
        tag.Parent = char
    end
end

tagSelf()
